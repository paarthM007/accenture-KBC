# C2 settings — copy to .env and adjust. All values shown are the defaults.

USE_MOCK_C1=true
USE_MOCK_C3=true
MOCK_SCENARIO=critical
C1_TIMEOUT_S=10
C3_TIMEOUT_S=30
LLM_TIMEOUT_S=20
MAX_UPLOAD_MB=10
FEEDBACK_LOG_PATH=./feedback.jsonl

# Real module names — C1_* is confirmed, C3_* is a placeholder (Phase1-Plan T1.1).
# Update the moment C3 confirms; nothing else needs to change.
C1_MODULE_NAME=ml_engine
C1_ENTRYPOINT_NAME=analyze_company
C3_MODULE_NAME=c3_engine
C3_ENTRYPOINT_NAME=enrich_report

# Mock failure/latency injection — for manual testing only. Automated tests
# override these directly on the settings object, not via env.
MOCK_C1_RAISE_ON_CALL=false
MOCK_C1_SLEEP_S=0.2
MOCK_C3_RAISE_ON_CALL=false
MOCK_C3_FAIL_LLM=false
MOCK_C3_SLEEP_S=1.5
